# Optional model-backed API. The Lecture 5a browser demo does not need this file.
# Choose openai, claude or ollama, and a model available in your account or local installation.
LLM_PROVIDER=ollama
LLM_MODEL=gpt-oss:20b
LLM_TIMEOUT_MS=60000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Explicit API version, configurable without modifying the adapter.
ANTHROPIC_VERSION=2023-06-01
PORT=3001
# Allowed frontend origin.
WEB_ORIGIN=http://localhost:5173
